DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/thai_procurement
ENABLE_EMBEDDINGS=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATASET_MODE=synthetic
ADMIN_INGESTION_TOKEN=
OFFICIAL_SNAPSHOT_METADATA=../../data/official/metadata/dga-egp-contract-2568-250.json
OFFICIAL_QUALITY_REPORT=../../reports/official_snapshot/data_quality_summary.json

# Optional multi-provider LLM routing. Keep disabled for offline/test runs.
ENABLE_LLM=false
LLM_PROVIDER=
LLM_PROVIDER_CHAIN=gemini,groq,openrouter,mock
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OKMD_API_KEY=
OKMD_MODEL=gemini-2.5-flash-lite
OKMD_BASE_URL=https://gen.ai.kku.ac.th/okmd/api/v1
ENABLE_OKMD_FALLBACK=false
THAILLM_API_KEY=
THAILLM_MODEL=Pathumma-ThaiLLM-qwen3-8b-think-3.0.0
THAILLM_BASE_URL=https://thaillm.or.th/api/v1
ENABLE_THAILLM_FALLBACK=false
